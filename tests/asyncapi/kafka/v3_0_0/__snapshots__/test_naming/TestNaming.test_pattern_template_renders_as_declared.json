{
  "asyncapi": "3.0.0",
  "channels": {
    "events.{version}:Handle": {
      "address": "events.{version}",
      "bindings": {
        "kafka": {
          "bindingVersion": "0.4.0",
          "topic": "events.{version}"
        }
      },
      "messages": {
        "SubscribeMessage": {
          "$ref": "#/components/messages/events.%7Bversion%7D:Handle:SubscribeMessage"
        }
      },
      "servers": [
        {
          "$ref": "#/servers/development"
        }
      ]
    }
  },
  "components": {
    "messages": {
      "events.{version}:Handle:SubscribeMessage": {
        "correlationId": {
          "location": "$message.header#/correlation_id"
        },
        "payload": {
          "$ref": "#/components/schemas/EmptyPayload"
        },
        "title": "events.{version}:Handle:SubscribeMessage"
      }
    },
    "schemas": {
      "EmptyPayload": {
        "title": "EmptyPayload",
        "type": "null"
      }
    }
  },
  "defaultContentType": "application/json",
  "info": {
    "title": "FastStream",
    "version": "0.1.0"
  },
  "operations": {
    "events.{version}:HandleSubscribe": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/events.%7Bversion%7D:Handle"
      },
      "messages": [
        {
          "$ref": "#/channels/events.%7Bversion%7D:Handle/messages/SubscribeMessage"
        }
      ]
    }
  },
  "servers": {
    "development": {
      "host": "localhost",
      "pathname": "",
      "protocol": "kafka",
      "protocolVersion": "auto"
    }
  }
}
